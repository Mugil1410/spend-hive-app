{
  "expo": {
    "name": "SpendHive",
    "slug": "spendhive",
    "version": "1.0.1",
    "scheme": "spendhive",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#262523"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spendhive"
    },
    "android": {
      "package": "com.spendhive",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-adaptive.png",
        "backgroundColor": "#262523"
      }
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickAdd",
              "label": "SpendHive Quick Add",
              "description": "Quickly add an expense or income",
              "minWidth": "250dp",
              "minHeight": "140dp",
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ca84777f-c603-4200-a262-b0fb467ddb54"
      }
    },
    "owner": "mugil1410"
  }
}
